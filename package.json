{
  "name": "studio-ordo",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "// --- Lifecycle ---": "",
    "prestart": "npm run native:check && npm run validate:env",
    "predev": "npm run native:check",
    "prejobs:work": "npm run native:check",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:search-index && next build",
    "start": "node scripts/start-server.mjs",
    "run": "npm run release:verify && npm run start",
    "// --- Quality & Check ---": "",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run test && npm run audit",
    "lint": "eslint",
    "lint:css": "stylelint \"src/app/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "node scripts/spacing-audit.js --threshold=0 && node scripts/scan-secrets.mjs && node scripts/assert-stateless-runtime.mjs",
    "// --- Build Assets ---": "",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:verify": "node scripts/validate-release-manifest.mjs",
    "// --- Admin & Operations ---": "",
    "admin:check": "npm run validate:env && tsx scripts/admin-health-sweep.ts && tsx scripts/admin-diagnostics.ts && tsx scripts/report-media-storage.ts",
    "admin:clean": "tsx scripts/reap-chat-uploads.ts && tsx scripts/run-conversation-retention-sweep.ts",
    "jobs:work": "tsx scripts/process-deferred-jobs.ts",
    "media:worker": "tsx scripts/media-worker-server.ts",
    "backup": "tsx scripts/process-backup-scheduler.ts",
    "// --- Evals & QA ---": "",
    "qa": "tsx scripts/run-runtime-integrity-qa.ts",
    "eval": "tsx scripts/run-live-eval.ts",
    "// --- Rust ---": "",
    "rust:check": "cargo fmt --check && cargo clippy -p ordo-backup -- -D warnings && cargo test -p ordo-backup && cargo deny check",
    "// --- Utilities ---": "",
    "llm:export": "tsx scripts/llm-export.ts",
    "push:vapid": "tsx scripts/generate-web-push-vapid.ts",
    "validate:env": "tsx scripts/validate-env.ts && node scripts/validate-env-parity.mjs",
    "native:check": "node scripts/check-native-runtime.mjs better-sqlite3 tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "mermaid": "^11.12.3",
    "next": "16.2.4",
    "openai": "^6.27.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^28.1.0",
    "pino-pretty": "^13.1.3",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "postcss": "8.5.13",
    "tmp": "0.2.5",
    "uuid": "14.0.0"
  }
}
