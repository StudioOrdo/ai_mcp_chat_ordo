# Copy values into your shell environment, .env.local, or Docker Compose .env.
# Provider settings can also be saved through /install and admin provider settings.

# Intelligence provider for chat, reasoning, summarization, and article text.
AI_PROVIDER=anthropic

# Anthropic intelligence provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=
ANTHROPIC_REQUEST_TIMEOUT_MS=10000
ANTHROPIC_RETRY_ATTEMPTS=2
ANTHROPIC_RETRY_DELAY_MS=150

# DeepSeek Anthropic-compatible intelligence provider.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_REQUEST_TIMEOUT_MS=10000
DEEPSEEK_RETRY_ATTEMPTS=2
DEEPSEEK_RETRY_DELAY_MS=150

# Optional capability providers. OpenAI is optional and is not the chat provider.
OPENAI_API_KEY=
IMAGE_PROVIDER=disabled
IMAGE_MODEL=gpt-image-1
TTS_PROVIDER=disabled
TTS_MODEL=tts-1
STT_PROVIDER=disabled
STT_MODEL=
WEB_SEARCH_PROVIDER=disabled
WEB_SEARCH_MODEL=gpt-5

# Legacy-compatible names (optional).
API__ANTHROPIC_API_KEY=
API__ANTHROPIC_MODEL=claude-haiku-4-5
API__ANTHROPIC_REQUEST_TIMEOUT_MS=10000
API__ANTHROPIC_RETRY_ATTEMPTS=2
API__ANTHROPIC_RETRY_DELAY_MS=150
API__OPENAI_API_KEY=

# Appliance resource guardrails.
ORDO_DATA_FREE_WARN_BYTES=2147483648
ORDO_DATA_FREE_WARN_PERCENT=15
ORDO_DATA_FREE_BLOCK_BYTES=536870912
ORDO_DATA_FREE_BLOCK_PERCENT=5
ORDO_TMP_SIZE=512m
ORDO_RUNTIME_LOG_TMPFS_SIZE=64m
ORDO_NEXT_CACHE_TMPFS_SIZE=256m
ORDO_PIDS_LIMIT=256
ORDO_MEMORY_RESERVATION=512m
ORDO_MEMORY_LIMIT=2g
ORDO_CPUS=2.0
ORDO_LOG_MAX_SIZE=10m
ORDO_LOG_MAX_FILE=5
ORDO_WORKER_MAX_RESTARTS=3
ORDO_WORKER_RESTART_WINDOW_MS=60000
